{
  "name": "panocut",
  "productName": "PanoCut",
  "version": "0.6.0",
  "description": "PanoCut – Videoschnitt für 360°-, Kamera- und Drohnenvideos in einem Programm",
  "author": "BlayZzo",
  "license": "MIT",
  "private": true,
  "main": "dist/main/main.js",
  "homepage": "https://github.com/BlayZzo/pano-cut",
  "repository": {
    "type": "git",
    "url": "https://github.com/BlayZzo/pano-cut.git"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build:main": "node scripts/build-main.mjs",
    "build:renderer": "vite build",
    "build": "npm run typecheck && npm run build:main && npm run build:renderer",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "package": "npm run build && electron-builder --publish never",
    "package:mac": "npm run build && electron-builder --mac --arm64 --x64 --publish never",
    "package:win": "npm run build && electron-builder --win --x64 --publish never",
    "release": "npm run build && electron-builder --publish always",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "electron-log": "^5.2.0",
    "electron-updater": "^6.3.0",
    "ffmpeg-static": "^5.2.0",
    "onnxruntime-node": "^1.19.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/three": "0.170.0",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "^35.1.0",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.24.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "0.170.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "zundo": "^2.3.0",
    "zustand": "^5.0.0"
  }
}
