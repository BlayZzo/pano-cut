{
  "Name": "PanoCut",
  "Version": "0.5.0.0",
  "Author": "BlayZzo",
  "Description": "Steuert den Videoeditor PanoCut: Abspielen, Schneiden, Markieren, Rückgängig, Export, KI und mehr.",
